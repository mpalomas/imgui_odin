// Odin bindings for Dear ImGui (docking branch), through dear_bindings' C API. The declarations are in
// imgui_generated.odin, generated by tools/gen.
//
// Functions taking a (text, text_end) pair take an Odin string. Printf-style functions take Odin format
// arguments (`Text("%d fps", fps)`). The C functions they wrap are `Raw<Name>`.
package imgui

import "core:c"

// Link the shared library (libdcimgui.dylib or .so) instead of the static one.
// Enable with -define:IMGUI_SHARED=true.
IMGUI_SHARED :: #config(IMGUI_SHARED, false)

when ODIN_OS == .Linux {
	@(private) OS  :: "linux"
	@(private) EXT :: ".so" when IMGUI_SHARED else ".a"
} else when ODIN_OS == .Darwin {
	@(private) OS  :: "macos"
	@(private) EXT :: ".dylib" when IMGUI_SHARED else ".a"
} else {
	#panic("imgui_odin: only Linux and macOS are supported for now")
}
@(private) ARCH :: "x86_64" when ODIN_ARCH == .amd64 else "arm64" when ODIN_ARCH == .arm64 else #panic("imgui_odin: unsupported architecture")

// Path of the library, relative to this directory. Override with -define:IMGUI_LIB=<path>.
IMGUI_LIB :: #config(IMGUI_LIB, "../lib/" + OS + "-" + ARCH + "/libdcimgui" + EXT)

when !#exists(IMGUI_LIB) {
	#panic("Could not find the Dear ImGui library at '" + IMGUI_LIB + "'. Run tools/fetch_imgui_libs.sh or tools/build_imgui.sh, or pass -define:IMGUI_LIB=<path>.")
}

// The `foreign import` is in imgui_generated.odin, since imports are file-scoped.

// Checks that the library is the version and has the layouts these bindings were generated for, as
// IMGUI_CHECKVERSION() does in C++. Asserts in the library otherwise.
CHECKVERSION :: proc() -> bool {
	return DebugCheckVersionAndDataLayout(
		VERSION,
		c.size_t(size_of(IO)),
		c.size_t(size_of(Style)),
		c.size_t(size_of(Vec2)),
		c.size_t(size_of(Vec4)),
		c.size_t(size_of(DrawVert)),
		c.size_t(size_of(DrawIdx)),
	)
}

// The begin and end pointers of a string, for the C functions taking a (text, text_end) pair. Never nil:
// ImGui reads a nil text_end as "up to the null terminator".
string_range :: #force_inline proc "contextless" (s: string) -> (begin, end: cstring) {
	if len(s) == 0 {
		empty := cstring("")
		return empty, empty
	}
	p := raw_data(s)
	return cstring(p), cstring(&p[len(s)])
}

// The elements of an ImVector.
vector_slice :: #force_inline proc "contextless" (v: Vector($T)) -> []T {
	return v.Data[:v.Size]
}

// IM_COL32: a packed RGBA color.
col32 :: #force_inline proc "contextless" (r, g, b, a: u8) -> u32 {
	return u32(r) << COL32_R_SHIFT | u32(g) << COL32_G_SHIFT | u32(b) << COL32_B_SHIFT | u32(a) << COL32_A_SHIFT
}

COL32_WHITE :: 0xFFFFFFFF
COL32_BLACK :: 0xFF000000
COL32_BLACK_TRANS :: 0x00000000

// A key chord: a key and modifiers, e.g. `key_chord(.S, .Mod_Ctrl)` for Ctrl+S.
key_chord :: #force_inline proc "contextless" (key: Key, mods: ..Key) -> KeyChord {
	chord := KeyChord(key)
	for m in mods {
		chord |= KeyChord(m)
	}
	return chord
}
