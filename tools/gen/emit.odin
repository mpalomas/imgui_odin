package main

import "core:fmt"
import "core:slice"
import "core:strconv"
import "core:strings"

ODIN_KEYWORDS :: [?]string{
	"asm", "auto_cast", "bit_field", "bit_set", "break", "case", "cast", "context", "continue", "defer",
	"distinct", "do", "dynamic", "else", "enum", "fallthrough", "for", "foreign", "if", "import", "in",
	"map", "matrix", "not_in", "or_break", "or_continue", "or_else", "or_return", "package", "proc",
	"return", "struct", "switch", "transmute", "typeid", "union", "using", "when", "where",
	// Not keywords, but the packages the generated code uses.
	"c", "fmt",
}

BUILTIN_TYPES :: [?][2]string{
	{"void", "void"},
	{"bool", "bool"},
	{"char", "u8"},
	{"unsigned_char", "u8"},
	{"short", "i16"},
	{"unsigned_short", "u16"},
	{"int", "c.int"},
	{"unsigned_int", "u32"},
	{"long_long", "i64"},
	{"unsigned_long_long", "u64"},
	{"float", "f32"},
	{"double", "f64"},
}

// Typedefs replaced by the Odin type they name. Their declarations are not emitted.
PRIMITIVE_TYPEDEFS :: [?][2]string{
	{"ImS8", "i8"},
	{"ImU8", "u8"},
	{"ImS16", "i16"},
	{"ImU16", "u16"},
	{"ImS32", "i32"},
	{"ImU32", "u32"},
	{"ImS64", "i64"},
	{"ImU64", "u64"},
	{"ImWchar16", "u16"},
	{"ImWchar32", "u32"},
	{"size_t", "c.size_t"},
}

// Structs emitted as Odin arrays, for their arithmetic and swizzles (`.x`, `.xy`). Same layout.
ARRAY_STRUCTS :: [?][2]string{
	{"ImVec2", "[2]f32"},
	{"ImVec4", "[4]f32"},
}

// Defines that are not values.
SKIPPED_DEFINES :: [?]string{
	"IMGUI_API",
	"IMGUI_IMPL_API",
	"IM_MSVC_RUNTIME_CHECKS_OFF",
	"IM_MSVC_RUNTIME_CHECKS_RESTORE",
	"IM_NODEBUGSTEP",
	"IM_ARRAYSIZE",
	"IMGUI_DEFINE_MATH_OPERATORS_IMPLEMENTED",
}

// Default argument values that are not literals.
DEFAULT_VALUES :: [?][2]string{
	{"FLT_MAX", "max(f32)"},
	{"-FLT_MIN", "-1.17549435e-38"}, // The smallest normal f32.
	{"sizeof(float)", "size_of(f32)"},
	{"IM_COL32_WHITE", "0xFFFFFFFF"},
}

// Variadic functions without a `<name>Unformatted` helper, and the function their Odin wrapper calls
// with the formatted text instead.
FORMAT_HELPERS :: [?][2]string{
	{"ImGui_Text", "ImGui_TextUnformatted"},
	{"ImGuiTextBuffer_appendf", "ImGuiTextBuffer_append"},
}

LIBRARY :: `// The library and its dependencies. IMGUI_LIB is in imgui.odin.
when ODIN_OS == .Linux {
	foreign import lib {
		IMGUI_LIB,
		"system:m",
	}
} else {
	foreign import lib {
		IMGUI_LIB,
	}
}

`

Enum_Info :: struct {
	e:       ^Enum,
	odin:    string, // The Odin type: `Col`, or the bit set `WindowFlags`.
	element: string, // Flags only: the bit set's enum, `WindowFlag`.
	backing: string, // `c.int`, `u8`...
	prefix:  string, // `ImGuiCol_`
	// Whether the elements are 0 to N - 1 with N its _COUNT, so `[ImGuiCol_COUNT]T` can be `[Col]T`.
	contiguous: bool,
	// Flags only: the elements that are numbers in a bit range rather than bits (see numbered_elements).
	numbered: map[string]bool,
}

// A function's string parameter: `text`, from a `text` + `text_end` (or `text_begin` + `text_end`) pair.
String_Pair :: struct {
	index: int, // Of the begin parameter.
	name:  string,
}

Emitter :: struct {
	b:        strings.Builder,
	ir:       ^IR,
	config:   Config,
	names:    map[string]string, // C type name → Odin type.
	enums:    map[string]^Enum_Info, // By C enum name and by typedef name.
	structs:  map[string]^Struct,
	typedefs: map[string]^Typedef,
	elements: map[string]i64, // C enum element name → value, for array bounds.
	declared: map[string]bool, // Top-level Odin names, to catch collisions.
	// Types that a struct field shadows, spelled through an alias in the fields after it.
	shadowed: map[string]bool,
	uses_fmt: bool,
	// The ABI check: what tools/abi/abi_check.c and the Odin program print, line for line.
	abi_c:    strings.Builder,
	abi_odin: strings.Builder,
	err:      string,
}

Output :: struct {
	bindings: string, // imgui_generated.odin
	abi_c:    string, // abi_check.c
	abi_odin: string, // abi_check/main.odin
}

// Generates the Odin bindings for a dcimgui.json. `source` only goes into the file header.
generate :: proc(json_src, config_src, source: string) -> (out: Output, err: string) {
	config := parse_config(config_src)
	ir, load_err := load(json_src, config)
	if load_err != "" {
		return {}, load_err
	}
	e := Emitter{ir = ir, config = config}
	collect(&e)
	emit_body(&e)
	if e.err != "" {
		return {}, e.err
	}

	b := strings.builder_make()
	fmt.sbprintf(&b, "// Code generated by tools/gen from %s. DO NOT EDIT.\n", source)
	version := ""
	for d in ir.defines {
		if d.name == "IMGUI_VERSION" {
			version = strings.trim(d.content, `"`)
		}
	}
	defines := make([dynamic]string)
	for name in config {
		append(&defines, name)
	}
	slice.sort(defines[:])
	fmt.sbprintf(&b, "// Dear ImGui %s, configured with %s.\n", version, strings.join(defines[:], ", "))
	strings.write_string(&b, "package imgui\n\nimport \"core:c\"\n")
	if e.uses_fmt {
		strings.write_string(&b, "import \"core:fmt\"\n")
	}
	strings.write_string(&b, "\n")
	strings.write_string(&b, LIBRARY)
	strings.write_string(&b, strings.to_string(e.b))
	out.bindings = strings.to_string(b)
	out.abi_c = abi_c_source(&e, source)
	out.abi_odin = abi_odin_source(&e, source)
	return out, ""
}

@(private = "file")
error :: proc(e: ^Emitter, format: string, args: ..any) {
	if e.err == "" {
		e.err = fmt.aprintf(format, ..args)
	}
}

escape :: proc(name: string) -> string {
	for k in ODIN_KEYWORDS {
		if name == k {
			return fmt.aprintf("%s_", name)
		}
	}
	return name
}

// `ImGuiIO` → `IO`, `ImDrawList` → `DrawList`, `ImGuiCol_COUNT` → `Col_COUNT`.
strip_im :: proc(name: string) -> string {
	if strings.has_prefix(name, "ImGui") && len(name) > len("ImGui") {
		return name[len("ImGui"):]
	}
	if strings.has_prefix(name, "Im") && len(name) > len("Im") {
		return name[len("Im"):]
	}
	return name
}

// `ImGui_Begin` → `Begin`, `ImDrawList_AddLine` → `DrawList_AddLine`, `ImGuiIO_AddKeyEvent` → `IO_AddKeyEvent`.
function_name :: proc(name: string) -> string {
	if strings.has_prefix(name, "ImGui_") {
		return name[len("ImGui_"):]
	}
	return strip_im(name)
}

@(private = "file")
declare :: proc(e: ^Emitter, name: string) {
	if e.declared[name] {
		error(e, "two declarations are named '%s' in Odin", name)
	}
	e.declared[name] = true
}

// Names every type before anything is emitted.
@(private = "file")
collect :: proc(e: ^Emitter) {
	for &t in e.ir.typedefs {
		e.typedefs[t.name] = &t
	}
	for &s in e.ir.structs {
		// A definition replaces a forward declaration.
		if existing, ok := e.structs[s.name]; !ok || existing.is_forward {
			e.structs[s.name] = &s
		}
		if !s.is_anonymous && !strings.has_prefix(s.name, "ImVector_") {
			e.names[s.name] = strip_im(s.name)
		}
	}
	for &en in e.ir.enums {
		base := strings.trim_suffix(en.name, "_")
		info := new(Enum_Info)
		info.e = &en
		info.odin = strip_im(base)
		info.prefix = fmt.aprintf("%s_", base)
		info.backing = "c.int"
		if en.is_flags {
			if !strings.has_suffix(info.odin, "Flags") {
				error(e, "flags enum %s: the name does not end in Flags_", en.name)
			}
			info.element = strings.trim_suffix(info.odin, "s")
		}
		e.enums[en.name] = info
		e.names[en.name] = info.odin
		if _, ok := e.typedefs[base]; ok {
			e.enums[base] = info
			e.names[base] = info.odin
		}
		for el in en.elements {
			e.elements[el.name] = el.value
		}
	}
	// After the enums: the backing types may be typedefs (`typedef ImU8 ImGuiSortDirection`).
	for &en in e.ir.enums {
		info := e.enums[en.name]
		if t, ok := e.typedefs[strings.trim_suffix(en.name, "_")]; ok {
			info.backing = odin_type(e, t.type)
		}
		info.contiguous = is_contiguous(&en)
		info.numbered = numbered_elements(&en)
	}
	for t in e.ir.typedefs {
		if _, is_enum := e.enums[t.name]; is_enum || primitive_typedef(t.name) != "" {
			continue
		}
		e.names[t.name] = strip_im(t.name)
	}
}

@(private = "file")
is_contiguous :: proc(en: ^Enum) -> bool {
	if en.is_flags {
		return false
	}
	count: i64 = -1
	lo, hi := max(i64), min(i64)
	for el in en.elements {
		if el.is_count {
			count = el.value
		} else {
			lo, hi = min(lo, el.value), max(hi, el.value)
		}
	}
	return count > 0 && lo == 0 && hi == count - 1
}

// Some flags hold a number in a range of bits: ImGuiPopupFlags_MouseButtonLeft, Right and Middle are
// `1<<2`, `2<<2` and `3<<2`, so Left and Right are single bits but Left | Right is Middle. Such elements
// are constants, not bit set members: all the `k<<S` elements of a shift S used with some k > 1.
@(private = "file")
numbered_elements :: proc(en: ^Enum) -> map[string]bool {
	// `k<<S` → k, S
	shifted :: proc(expression: string) -> (k, shift: i64, ok: bool) {
		i := strings.index(expression, "<<")
		if i < 0 {
			return
		}
		k = strconv.parse_i64(strings.trim_space(expression[:i])) or_return
		shift = strconv.parse_i64(strings.trim_space(expression[i + 2:])) or_return
		return k, shift, true
	}
	numbered := make(map[string]bool)
	if !en.is_flags {
		return numbered
	}
	shifts := make(map[i64]bool)
	for el in en.elements {
		if k, shift, ok := shifted(el.expression); ok && k > 1 {
			shifts[shift] = true
		}
	}
	for el in en.elements {
		if _, shift, ok := shifted(el.expression); ok && shifts[shift] {
			numbered[el.name] = true
		}
	}
	return numbered
}

@(private = "file")
primitive_typedef :: proc(name: string) -> string {
	for p in PRIMITIVE_TYPEDEFS {
		if p[0] == name {
			return p[1]
		}
	}
	return ""
}

@(private = "file")
user_type :: proc(e: ^Emitter, name: string) -> string {
	if p := primitive_typedef(name); p != "" {
		return p
	}
	if strings.has_prefix(name, "ImVector_") {
		s, ok := e.structs[name]
		if !ok {
			error(e, "unknown vector type '%s'", name)
			return name
		}
		for f in s.fields {
			if f.name == "Data" && f.type.kind == .Pointer {
				return fmt.aprintf("Vector(%s)", odin_type(e, f.type.inner^))
			}
		}
		error(e, "%s has no Data pointer", name)
		return name
	}
	if n, ok := e.names[name]; ok {
		return n
	}
	error(e, "unknown C type '%s'", name)
	return name
}

// `multi` makes the outermost pointer a multi-pointer.
@(private = "file")
odin_type :: proc(e: ^Emitter, t: Type, multi := false) -> string {
	switch t.kind {
	case .Builtin:
		for b in BUILTIN_TYPES {
			if b[0] == t.name {
				return b[1]
			}
		}
		error(e, "unknown builtin type '%s'", t.name)
		return t.name
	case .User:
		return user_type(e, t.name)
	case .Named:
		return odin_type(e, t.inner^, multi)
	case .Function:
		return proc_type(e, t)
	case .Array:
		return fmt.aprintf("[%s]%s", array_length(e, t.bounds), odin_type(e, t.inner^))
	case .Pointer:
		inner := t.inner^
		for inner.kind == .Named {
			inner = inner.inner^
		}
		if inner.kind == .Function {
			return proc_type(e, inner)
		}
		if inner.kind == .Builtin && inner.name == "void" {
			return "rawptr"
		}
		// A const char* is a string, a char* a buffer.
		if inner.kind == .Builtin && inner.name == "char" {
			return "cstring" if inner.is_const else "[^]u8"
		}
		return fmt.aprintf("%s%s", "[^]" if multi else "^", odin_type(e, inner))
	}
	return ""
}

// `proc "c" (name: T, ...) -> R`
@(private = "file")
proc_type :: proc(e: ^Emitter, f: Type) -> string {
	b := strings.builder_make()
	strings.write_string(&b, `proc "c" (`)
	for p, i in f.params {
		if i > 0 {
			strings.write_string(&b, ", ")
		}
		name := p.name if p.kind == .Named && p.name != "" else fmt.tprintf("arg%d", i)
		fmt.sbprintf(&b, "%s: %s", escape(name), odin_type(e, p))
	}
	strings.write_string(&b, ")")
	if !is_void(f.ret^) {
		fmt.sbprintf(&b, " -> %s", odin_type(e, f.ret^))
	}
	return strings.to_string(b)
}

@(private = "file")
is_void :: proc(t: Type) -> bool {
	return t.kind == .Builtin && t.name == "void"
}

// An array length: the name of the Odin constant when the bounds are one, else the computed value.
@(private = "file")
array_length :: proc(e: ^Emitter, bounds: string) -> string {
	if _, is_element := e.elements[bounds]; is_element {
		return strip_im(bounds)
	}
	value, ok := eval_bounds(e, bounds)
	if !ok {
		error(e, "cannot compute the array bounds '%s'", bounds)
	}
	return fmt.aprintf("%d", value)
}

@(private = "file")
Eval :: struct {
	e:   ^Emitter,
	src: string,
	pos: int,
}

// Evaluates `32+1` or `(IM_UNICODE_CODEPOINT_MAX +1)/8192/8`: integers, defines, enum elements, + - * / and
// parentheses.
@(private = "file")
eval_bounds :: proc(e: ^Emitter, src: string) -> (value: i64, ok: bool) {
	s := Eval{e, src, 0}
	value = eval_sum(&s) or_return
	eval_skip_space(&s)
	return value, s.pos == len(src)
}

@(private = "file")
eval_skip_space :: proc(s: ^Eval) {
	for s.pos < len(s.src) && s.src[s.pos] == ' ' {
		s.pos += 1
	}
}

@(private = "file")
eval_primary :: proc(s: ^Eval) -> (v: i64, ok: bool) {
	eval_skip_space(s)
	if s.pos >= len(s.src) {
		return 0, false
	}
	if s.src[s.pos] == '(' {
		s.pos += 1
		v = eval_sum(s) or_return
		eval_skip_space(s)
		if s.pos >= len(s.src) || s.src[s.pos] != ')' {
			return 0, false
		}
		s.pos += 1
		return v, true
	}
	start := s.pos
	for s.pos < len(s.src) && is_ident_char(s.src[s.pos]) {
		s.pos += 1
	}
	word := s.src[start:s.pos]
	if word == "" {
		return 0, false
	}
	if is_digit(word[0]) {
		return strconv.parse_i64(word)
	}
	if value, is_element := s.e.elements[word]; is_element {
		return value, true
	}
	for d in s.e.ir.defines {
		if d.name == word {
			return strconv.parse_i64(d.content)
		}
	}
	return 0, false
}

@(private = "file")
eval_product :: proc(s: ^Eval) -> (v: i64, ok: bool) {
	v = eval_primary(s) or_return
	for {
		eval_skip_space(s)
		if s.pos >= len(s.src) || (s.src[s.pos] != '*' && s.src[s.pos] != '/') {
			return v, true
		}
		op := s.src[s.pos]
		s.pos += 1
		rhs := eval_primary(s) or_return
		if op == '*' {
			v *= rhs
		} else if rhs != 0 {
			v /= rhs
		} else {
			return 0, false
		}
	}
}

@(private = "file")
eval_sum :: proc(s: ^Eval) -> (v: i64, ok: bool) {
	v = eval_product(s) or_return
	for {
		eval_skip_space(s)
		if s.pos >= len(s.src) || (s.src[s.pos] != '+' && s.src[s.pos] != '-') {
			return v, true
		}
		op := s.src[s.pos]
		s.pos += 1
		rhs := eval_product(s) or_return
		v = v + rhs if op == '+' else v - rhs
	}
}

is_ident_char :: proc(c: u8) -> bool {
	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c)
}

is_digit :: proc(c: u8) -> bool {
	return c >= '0' && c <= '9'
}

@(private = "file")
write_comments :: proc(e: ^Emitter, c: Comments, indent: string) {
	for line in c.preceding {
		fmt.sbprintf(&e.b, "%s%s\n", indent, line)
	}
}

@(private = "file")
write_attached :: proc(e: ^Emitter, c: Comments) {
	if c.attached != "" {
		fmt.sbprintf(&e.b, " %s", c.attached)
	}
	strings.write_string(&e.b, "\n")
}

@(private = "file")
emit_body :: proc(e: ^Emitter) {
	emit_defines(e)
	emit_typedefs(e)
	for &en in e.ir.enums {
		emit_enum(e, &en)
	}
	strings.write_string(&e.b, "Vector :: struct($T: typeid) {\n\tSize:     c.int,\n\tCapacity: c.int,\n\tData:     [^]T,\n}\n\n")
	declare(e, "Vector")
	for &s in e.ir.structs {
		if e.structs[s.name] == &s {
			emit_struct(e, &s)
		}
	}
	if len(e.shadowed) > 0 {
		names := make([dynamic]string)
		for name in e.shadowed {
			append(&names, name)
		}
		slice.sort(names[:])
		strings.write_string(&e.b, "// Aliases for the types that a struct field of the same name hides from the fields after it.\n")
		for name in names {
			fmt.sbprintf(&e.b, "@(private) _%s :: %s\n", name, name)
		}
		strings.write_string(&e.b, "\n")
	}
	emit_functions(e)
}

// A define's Odin name: `IMGUI_VERSION` → `VERSION`, `IM_COL32_A_MASK` → `COL32_A_MASK`,
// `ImTextureID_Invalid` → `TextureID_Invalid`.
@(private = "file")
define_name :: proc(name: string) -> string {
	if strings.has_prefix(name, "IMGUI_") {
		return name[len("IMGUI_"):]
	}
	if strings.has_prefix(name, "IM_") {
		return name[len("IM_"):]
	}
	return strip_im(name)
}

@(private = "file")
emit_defines :: proc(e: ^Emitter) {
	outer: for d in e.ir.defines {
		for skipped in SKIPPED_DEFINES {
			if d.name == skipped {
				continue outer
			}
		}
		name := define_name(d.name)
		value := strings.trim_space(d.content)
		switch {
		case value == "":
			// IMGUI_HAS_DOCK...
			value = "true"
		case strings.has_prefix(value, `"`):
		case strings.has_prefix(value, "("):
			// `(ImTextureID)0`
			close := strings.index_byte(value, ')')
			if close < 0 {
				error(e, "unsupported value for define %s", d.name)
				continue
			}
			value = fmt.aprintf("%s(%s)", user_type(e, value[1:close]), value[close + 1:])
		case:
			if _, ok := strconv.parse_i64(value); !ok {
				error(e, "unsupported value '%s' for define %s", value, d.name)
				continue
			}
		}
		declare(e, name)
		write_comments(e, d.comments, "")
		fmt.sbprintf(&e.b, "%s :: %s", name, value)
		write_attached(e, d.comments)
	}
	strings.write_string(&e.b, "\n")
}

@(private = "file")
emit_typedefs :: proc(e: ^Emitter) {
	for t in e.ir.typedefs {
		if _, is_enum := e.enums[t.name]; is_enum || primitive_typedef(t.name) != "" {
			continue
		}
		name := e.names[t.name]
		declare(e, name)
		write_comments(e, t.comments, "")
		inner := t.type
		for inner.kind == .Named {
			inner = inner.inner^
		}
		if inner.kind == .Pointer && inner.inner.kind == .Function {
			fmt.sbprintf(&e.b, "%s :: #type %s", name, odin_type(e, inner))
		} else {
			fmt.sbprintf(&e.b, "%s :: %s", name, odin_type(e, t.type))
			abi_size(e, t.name, name)
		}
		write_attached(e, t.comments)
	}
	strings.write_string(&e.b, "\n")
}

// The Odin name of an enum element: `ImGuiCol_Text` → `Text`, `ImGuiKey_0` → `_0`, and in ImGuiKey,
// `ImGuiMod_Ctrl` → `Mod_Ctrl`.
@(private = "file")
element_name :: proc(info: ^Enum_Info, name: string) -> string {
	n := strings.trim_prefix(name, info.prefix) if strings.has_prefix(name, info.prefix) else strip_im(name)
	if len(n) > 0 && is_digit(n[0]) {
		return fmt.aprintf("_%s", n)
	}
	return escape(n)
}

@(private = "file")
single_bit :: proc(v: i64) -> (bit: int, ok: bool) {
	u := u64(u32(v))
	if v < 0 || u == 0 || u & (u - 1) != 0 {
		return 0, false
	}
	for u > 1 {
		u >>= 1
		bit += 1
	}
	return bit, true
}

// A value of a flags enum as a bit set constant: `WindowFlags{.NoTitleBar, .NoResize}`, or a transmute
// when some of its bits have no element.
@(private = "file")
flags_value :: proc(e: ^Emitter, info: ^Enum_Info, v: i64) -> string {
	bits := u64(u32(v))
	b := strings.builder_make()
	fmt.sbprintf(&b, "%s{{", info.odin)
	n := 0
	for bit in 0 ..< 32 {
		if bits & (1 << uint(bit)) == 0 {
			continue
		}
		member := ""
		for el in info.e.elements {
			if b, ok := single_bit(el.value); ok && b == bit && is_flag_member(info, el) {
				member = element_name(info, el.name)
				break
			}
		}
		if member == "" {
			return fmt.aprintf("transmute(%s)%s(%d)", info.odin, info.backing, v)
		}
		if n > 0 {
			strings.write_string(&b, ", ")
		}
		fmt.sbprintf(&b, ".%s", member)
		n += 1
	}
	strings.write_string(&b, "}")
	return strings.to_string(b)
}

// Whether a flags enum element is a member of the bit set's enum: a single bit, neither private (`Mask_`)
// nor part of a number.
@(private = "file")
is_flag_member :: proc(info: ^Enum_Info, el: Enum_Element) -> bool {
	_, ok := single_bit(el.value)
	return ok && !strings.has_suffix(el.name, "_") && !info.numbered[el.name]
}

@(private = "file")
emit_enum :: proc(e: ^Emitter, en: ^Enum) {
	info := e.enums[en.name]
	write_comments(e, en.comments, "")
	// Elements that are not members: _COUNT values, and for flags, combinations of bits and masks.
	constants := make([dynamic]Enum_Element)
	if en.is_flags {
		declare(e, info.element)
		declare(e, info.odin)
		fmt.sbprintf(&e.b, "%s :: enum %s {{\n", info.element, info.backing)
		for el in en.elements {
			if is_flag_member(info, el) {
				bit, _ := single_bit(el.value)
				write_comments(e, el.comments, "\t")
				fmt.sbprintf(&e.b, "\t%s = %d,", element_name(info, el.name), bit)
				write_attached(e, el.comments)
				abi_enum(e, el.name, fmt.tprintf("transmute(%s)im.%s{{.%s}}", info.backing, info.odin, element_name(info, el.name)))
			} else if !(el.value == 0 && strings.has_suffix(el.name, "_None")) {
				append(&constants, el)
			}
		}
		fmt.sbprintf(&e.b, "}}\n%s :: bit_set[%s; %s]\n", info.odin, info.element, info.backing)
		for el in constants {
			name := strip_im(el.name)
			declare(e, name)
			write_comments(e, el.comments, "")
			if strings.has_suffix(el.name, "Shift_") {
				// A shift amount, not flags.
				fmt.sbprintf(&e.b, "%s :: %d", name, el.value)
				abi_enum(e, el.name, fmt.tprintf("im.%s", name))
			} else {
				fmt.sbprintf(&e.b, "%s :: %s", name, flags_value(e, info, el.value))
				abi_enum(e, el.name, fmt.tprintf("transmute(%s)im.%s", info.backing, name))
			}
			write_attached(e, el.comments)
		}
	} else {
		declare(e, info.odin)
		fmt.sbprintf(&e.b, "%s :: enum %s {{\n", info.odin, info.backing)
		for el in en.elements {
			if el.is_count {
				append(&constants, el)
				continue
			}
			write_comments(e, el.comments, "\t")
			fmt.sbprintf(&e.b, "\t%s = %d,", element_name(info, el.name), el.value)
			write_attached(e, el.comments)
			abi_enum(e, el.name, fmt.tprintf("im.%s.%s", info.odin, element_name(info, el.name)))
		}
		strings.write_string(&e.b, "}\n")
		for el in constants {
			name := strip_im(el.name)
			declare(e, name)
			write_comments(e, el.comments, "")
			fmt.sbprintf(&e.b, "%s :: %d", name, el.value)
			write_attached(e, el.comments)
			abi_enum(e, el.name, fmt.tprintf("im.%s", name))
		}
	}
	strings.write_string(&e.b, "\n")
}

@(private = "file")
emit_struct :: proc(e: ^Emitter, s: ^Struct) {
	if s.is_anonymous || strings.has_prefix(s.name, "ImVector_") {
		if strings.has_prefix(s.name, "ImVector_") {
			// The layout of a Vector does not depend on its element type.
			abi_size(e, s.name, "Vector(rawptr)")
		}
		return
	}
	name := e.names[s.name]
	declare(e, name)
	write_comments(e, s.comments, "")
	for a in ARRAY_STRUCTS {
		if a[0] == s.name {
			fmt.sbprintf(&e.b, "%s :: %s", name, a[1])
			write_attached(e, s.comments)
			strings.write_string(&e.b, "\n")
			abi_size(e, s.name, name)
			return
		}
	}
	if s.is_forward {
		// Opaque: only used through pointers.
		fmt.sbprintf(&e.b, "%s :: struct {{}}", name)
		write_attached(e, s.comments)
		strings.write_string(&e.b, "\n")
		return
	}
	fmt.sbprintf(&e.b, "%s :: struct%s {{", name, " #raw_union" if s.is_union else "")
	write_attached(e, s.comments)
	seen := make(map[string]bool)
	emit_fields(e, s, name, s.fields, "\t", &seen)
	strings.write_string(&e.b, "}\n\n")
	abi_size(e, s.name, name)
}

@(private = "file")
emit_fields :: proc(e: ^Emitter, s: ^Struct, odin_struct: string, fields: []Field, indent: string, seen: ^map[string]bool) {
	for i := 0; i < len(fields); i += 1 {
		f := fields[i]
		seen[escape(f.name)] = true
		write_comments(e, f.comments, indent)
		switch {
		case f.width > 0:
			// Consecutive bitfields of the same type share one bit_field.
			backing := odin_type(e, f.type)
			fmt.sbprintf(&e.b, "%susing _: bit_field %s {{\n", indent, backing)
			for ; i < len(fields) && fields[i].width > 0 && odin_type(e, fields[i].type) == backing; i += 1 {
				bf := fields[i]
				fmt.sbprintf(&e.b, "%s\t%s: %s | %d,", indent, escape(bf.name), backing, bf.width)
				write_attached(e, bf.comments)
			}
			i -= 1
			fmt.sbprintf(&e.b, "%s},\n", indent)
		case f.is_anonymous:
			inner, ok := e.structs[f.type.name]
			if !ok {
				error(e, "%s.%s: unknown anonymous type '%s'", s.name, f.name, f.type.name)
				continue
			}
			fmt.sbprintf(&e.b, "%susing _: struct%s {{\n", indent, " #raw_union" if inner.is_union else "")
			emit_fields(e, s, odin_struct, inner.fields, fmt.tprintf("%s\t", indent), seen)
			fmt.sbprintf(&e.b, "%s},\n", indent)
		case:
			type: string
			// `[ImGuiCol_COUNT]ImVec4` → `[Col]Vec4`
			if f.type.kind == .Array {
				if info, ok := enum_of_count(e, f.type.bounds); ok && info.contiguous {
					type = fmt.aprintf("[%s]%s", info.odin, odin_type(e, f.type.inner^))
				}
			}
			if type == "" {
				type = odin_type(e, f.type)
			}
			type = unshadow(e, type, seen^)
			fmt.sbprintf(&e.b, "%s%s: %s,", indent, escape(f.name), type)
			write_attached(e, f.comments)
			abi_offset(e, s.name, f.name, odin_struct, escape(f.name))
		}
	}
}

// In a struct, a field name hides the type of the same name, for that field and the ones after it:
// `ConfigFlags: ConfigFlags` does not compile. Such types are spelled through an alias, `_ConfigFlags`.
@(private = "file")
unshadow :: proc(e: ^Emitter, type: string, fields: map[string]bool) -> string {
	b := strings.builder_make()
	for i := 0; i < len(type); {
		if !is_ident_char(type[i]) {
			strings.write_byte(&b, type[i])
			i += 1
			continue
		}
		start := i
		for i < len(type) && is_ident_char(type[i]) {
			i += 1
		}
		word := type[start:i]
		// Not after a `.`: `c.int` names a package's declaration.
		if fields[word] && !(start > 0 && type[start - 1] == '.') {
			e.shadowed[word] = true
			strings.write_byte(&b, '_')
		}
		strings.write_string(&b, word)
	}
	return strings.to_string(b)
}

// The enum whose _COUNT element `name` is.
@(private = "file")
enum_of_count :: proc(e: ^Emitter, name: string) -> (^Enum_Info, bool) {
	for _, info in e.enums {
		for el in info.e.elements {
			if el.is_count && el.name == name {
				return info, true
			}
		}
	}
	return nil, false
}

@(private = "file")
string_pair :: proc(params: []Param) -> (pair: String_Pair, ok: bool) {
	is_string :: proc(p: Param) -> bool {
		t := p.type
		return t.kind == .Pointer && t.inner.kind == .Builtin && t.inner.name == "char" && t.inner.is_const
	}
	for i in 0 ..< len(params) - 1 {
		begin, end := params[i], params[i + 1]
		if !is_string(begin) || !is_string(end) || !strings.has_suffix(end.name, "_end") {
			continue
		}
		base := strings.trim_suffix(end.name, "_end")
		if begin.name == base || begin.name == fmt.tprintf("%s_begin", base) {
			return {i, base}, true
		}
	}
	return {}, false
}

// The Odin type of a parameter. Arrays are pointers (`float v[3]` → `^[3]f32`), and a pointer followed by
// its count (`values` + `values_count`, `points` + `num_points`) a multi-pointer.
@(private = "file")
param_type :: proc(e: ^Emitter, params: []Param, i: int) -> string {
	p := params[i]
	if p.type.kind == .Array {
		elem := odin_type(e, p.type.inner^)
		if p.type.bounds == "" {
			return fmt.aprintf("[^]%s", elem)
		}
		return fmt.aprintf("^[%s]%s", array_length(e, p.type.bounds), elem)
	}
	multi := false
	if i + 1 < len(params) {
		next := params[i + 1].name
		multi = next == fmt.tprintf("%s_count", p.name) || next == fmt.tprintf("num_%s", p.name)
	}
	return odin_type(e, p.type, multi)
}

// The Odin default value of a parameter.
@(private = "file")
default_value :: proc(e: ^Emitter, fn: Function, p: Param) -> string {
	v := strings.trim_space(p.default_value)
	for d in DEFAULT_VALUES {
		if d[0] == v {
			return d[1]
		}
	}
	switch v {
	case "NULL":
		return "nil"
	case "true", "false":
		return v
	}
	if strings.has_prefix(v, `"`) {
		return v
	}
	if strings.has_prefix(v, "ImVec2(") || strings.has_prefix(v, "ImVec4(") {
		args := strings.split(v[len("ImVec2("):len(v) - 1], ",")
		parts := make([dynamic]string)
		for a in args {
			arg := strings.trim_space(a)
			value := ""
			for d in DEFAULT_VALUES {
				if d[0] == arg {
					value = d[1]
				}
			}
			if value == "" {
				value = number(e, fn, arg)
			}
			append(&parts, value)
		}
		return fmt.aprintf("{{%s}}", strings.join(parts[:], ", "))
	}
	if p.type.kind == .User {
		if info, ok := e.enums[p.type.name]; ok {
			n, is_int := strconv.parse_i64(v)
			if !is_int {
				error(e, "%s: unsupported default value '%s' for %s", fn.name, v, p.name)
				return v
			}
			if info.e.is_flags {
				return "{}" if n == 0 else flags_value(e, info, n)
			}
			for el in info.e.elements {
				if el.value == n && !el.is_count {
					return fmt.aprintf(".%s", element_name(info, el.name))
				}
			}
			return fmt.aprintf("%s(%d)", info.odin, n)
		}
	}
	return number(e, fn, v)
}

// A C number literal in Odin: `1.0f` → `1.0`, `-1.f` → `-1.0`, `+360.0f` → `360.0`.
@(private = "file")
number :: proc(e: ^Emitter, fn: Function, v: string) -> string {
	n := strings.trim_prefix(v, "+")
	if strings.contains_any(n, ".e") {
		n = strings.trim_suffix(n, "f")
		if strings.has_suffix(n, ".") {
			n = fmt.aprintf("%s0", n)
		}
		if _, ok := strconv.parse_f64(n); ok {
			return n
		}
	} else if _, ok := strconv.parse_i64(n); ok {
		return n
	}
	error(e, "%s: unsupported default value '%s'", fn.name, v)
	return v
}

@(private = "file")
returns :: proc(e: ^Emitter, fn: Function) -> string {
	if is_void(fn.ret) {
		return ""
	}
	return fmt.aprintf(" -> %s", odin_type(e, fn.ret))
}

@(private = "file")
find_function :: proc(e: ^Emitter, name: string) -> ^Function {
	for &f in e.ir.functions {
		if f.name == name {
			return &f
		}
	}
	return nil
}

// Functions emitted as `Raw<Name>`, wrapped by an Odin proc of the same name: string pairs (the wrapper
// takes a `string`) and variadic functions (the wrapper takes Odin format arguments).
@(private = "file")
is_wrapped :: proc(fn: Function) -> bool {
	if _, ok := string_pair(fn.params); ok {
		return true
	}
	return len(fn.params) > 0 && fn.params[len(fn.params) - 1].is_varargs
}

@(private = "file")
uses_va_list :: proc(fn: Function) -> bool {
	for p in fn.params {
		if p.type.kind == .User && p.type.name == "va_list" {
			return true
		}
	}
	return false
}

@(private = "file")
emit_functions :: proc(e: ^Emitter) {
	strings.write_string(&e.b, "@(default_calling_convention = \"c\")\nforeign lib {\n")
	for fn in e.ir.functions {
		// The `V` functions taking a va_list cannot be called from Odin.
		if uses_va_list(fn) {
			continue
		}
		name := function_name(fn.name)
		if is_wrapped(fn) {
			name = fmt.aprintf("Raw%s", name)
		}
		declare(e, name)
		write_comments(e, fn.comments, "\t")
		fmt.sbprintf(&e.b, "\t@(link_name = %q)\n\t%s :: proc(", fn.name, name)
		for p, i in fn.params {
			if i > 0 {
				strings.write_string(&e.b, ", ")
			}
			if p.is_varargs {
				strings.write_string(&e.b, "#c_vararg args: ..any")
				continue
			}
			fmt.sbprintf(&e.b, "%s: %s", escape(p.name), param_type(e, fn.params, i))
			if p.has_default {
				fmt.sbprintf(&e.b, " = %s", default_value(e, fn, p))
			}
		}
		fmt.sbprintf(&e.b, ")%s ---", returns(e, fn))
		write_attached(e, fn.comments)
	}
	strings.write_string(&e.b, "}\n")

	for fn in e.ir.functions {
		if uses_va_list(fn) || !is_wrapped(fn) {
			continue
		}
		if pair, ok := string_pair(fn.params); ok {
			emit_string_wrapper(e, fn, pair)
		} else {
			emit_format_wrapper(e, fn)
		}
	}
}

// Writes the parameters `params[from:to]`, with their defaults, and returns the arguments to pass them on.
@(private = "file")
write_params :: proc(e: ^Emitter, fn: Function, from, to: int, args: ^[dynamic]string, first: ^bool) {
	for i in from ..< to {
		p := fn.params[i]
		if !first^ {
			strings.write_string(&e.b, ", ")
		}
		first^ = false
		fmt.sbprintf(&e.b, "%s: %s", escape(p.name), param_type(e, fn.params, i))
		if p.has_default {
			fmt.sbprintf(&e.b, " = %s", default_value(e, fn, p))
		}
		append(args, escape(p.name))
	}
}

// `TextUnformatted :: proc(text: string)`, calling `RawTextUnformatted(text, text_end)`.
@(private = "file")
emit_string_wrapper :: proc(e: ^Emitter, fn: Function, pair: String_Pair) {
	name := function_name(fn.name)
	declare(e, name)
	text := escape(pair.name)
	write_comments(e, fn.comments, "")
	fmt.sbprintf(&e.b, "\n%s :: proc(", name)
	args := make([dynamic]string)
	first := true
	write_params(e, fn, 0, pair.index, &args, &first)
	if !first {
		strings.write_string(&e.b, ", ")
	}
	fmt.sbprintf(&e.b, "%s: string", text)
	append(&args, "_begin", "_end")
	first = false
	write_params(e, fn, pair.index + 2, len(fn.params), &args, &first)
	fmt.sbprintf(&e.b, ")%s {{", returns(e, fn))
	write_attached(e, fn.comments)
	fmt.sbprintf(&e.b, "\t_begin, _end := string_range(%s)\n", text)
	fmt.sbprintf(&e.b, "\t%sRaw%s(%s)\n}\n", "" if is_void(fn.ret) else "return ", name, strings.join(args[:], ", "))
}

// `Text :: proc(format: string, args: ..any)`, calling the function's `Unformatted` helper with the text
// formatted by core:fmt.
@(private = "file")
emit_format_wrapper :: proc(e: ^Emitter, fn: Function) {
	name := function_name(fn.name)
	helper_name := fmt.aprintf("%sUnformatted", fn.name)
	for h in FORMAT_HELPERS {
		if h[0] == fn.name {
			helper_name = h[1]
		}
	}
	helper := find_function(e, helper_name)
	// The format parameter, before the `...`.
	format_index := len(fn.params) - 2
	if helper == nil || format_index < 0 || len(helper.params) <= format_index {
		error(e, "variadic function %s has no %s to wrap it with", fn.name, helper_name)
		return
	}
	declare(e, name)
	e.uses_fmt = true
	write_comments(e, fn.comments, "")
	fmt.sbprintf(&e.b, "\n%s :: proc(", name)
	args := make([dynamic]string)
	first := true
	write_params(e, fn, 0, format_index, &args, &first)
	if !first {
		strings.write_string(&e.b, ", ")
	}
	strings.write_string(&e.b, "format: string, args: ..any")
	fmt.sbprintf(&e.b, ")%s {{", returns(e, fn))
	write_attached(e, fn.comments)
	// Helpers with a string pair have an Odin wrapper taking a string.
	if _, has_pair := string_pair(helper.params); has_pair {
		append(&args, "fmt.tprintf(format, ..args)")
	} else {
		append(&args, "fmt.ctprintf(format, ..args)")
	}
	fmt.sbprintf(&e.b, "\t%s%s(%s)\n}\n", "" if is_void(fn.ret) else "return ", function_name(helper.name), strings.join(args[:], ", "))
}

// The ABI check. Each line is printed by both programs: `sizeof ImGuiIO <n>`, `offsetof ImGuiIO.Fonts
// <n>`, `enum ImGuiCol_Text <n>`, with the C value on one side and the Odin one on the other.

@(private = "file")
abi_size :: proc(e: ^Emitter, c_name, odin_name: string) {
	fmt.sbprintf(&e.abi_c, "\tprintf(\"sizeof %s %%zu\\n\", sizeof(%s));\n", c_name, c_name)
	fmt.sbprintf(&e.abi_c, "\tprintf(\"alignof %s %%zu\\n\", _Alignof(%s));\n", c_name, c_name)
	fmt.sbprintf(&e.abi_odin, "\tfmt.printfln(\"sizeof %s %%d\", size_of(im.%s))\n", c_name, odin_name)
	fmt.sbprintf(&e.abi_odin, "\tfmt.printfln(\"alignof %s %%d\", align_of(im.%s))\n", c_name, odin_name)
}

@(private = "file")
abi_offset :: proc(e: ^Emitter, c_struct, c_field, odin_struct, odin_field: string) {
	fmt.sbprintf(&e.abi_c, "\tprintf(\"offsetof %s.%s %%zu\\n\", offsetof(%s, %s));\n", c_struct, c_field, c_struct, c_field)
	fmt.sbprintf(&e.abi_odin, "\tfmt.printfln(\"offsetof %s.%s %%d\", offset_of(im.%s, %s))\n", c_struct, c_field, odin_struct, odin_field)
}

// `odin_value` is an Odin expression of the element's value, the package imported as `im`.
@(private = "file")
abi_enum :: proc(e: ^Emitter, c_name, odin_value: string) {
	fmt.sbprintf(&e.abi_c, "\tprintf(\"enum %s %%lld\\n\", (long long)%s);\n", c_name, c_name)
	fmt.sbprintf(&e.abi_odin, "\tfmt.printfln(\"enum %s %%d\", i64(%s))\n", c_name, odin_value)
}

@(private = "file")
abi_c_source :: proc(e: ^Emitter, source: string) -> string {
	b := strings.builder_make()
	fmt.sbprintf(&b, "// Code generated by tools/gen from %s. DO NOT EDIT.\n", source)
	strings.write_string(&b, "// Prints the layout of the C API, to compare with tools/abi/odin. See tools/abi/check.sh.\n")
	strings.write_string(&b, "#include <stddef.h>\n#include <stdio.h>\n#include \"dcimgui_nodefaultargfunctions.h\"\n\nint main(void) {\n")
	strings.write_string(&b, strings.to_string(e.abi_c))
	strings.write_string(&b, "\treturn 0;\n}\n")
	return strings.to_string(b)
}

@(private = "file")
abi_odin_source :: proc(e: ^Emitter, source: string) -> string {
	b := strings.builder_make()
	fmt.sbprintf(&b, "// Code generated by tools/gen from %s. DO NOT EDIT.\n", source)
	strings.write_string(&b, "// Prints the layout of the Odin bindings, to compare with tools/abi/abi_check.c. See tools/abi/check.sh.\n")
	strings.write_string(&b, "package abi_check\n\nimport \"core:c\"\nimport \"core:fmt\"\nimport im \"../../../imgui\"\n\n")
	strings.write_string(&b, "_ :: c\n\nmain :: proc() {\n")
	strings.write_string(&b, strings.to_string(e.abi_odin))
	strings.write_string(&b, "}\n")
	return strings.to_string(b)
}
